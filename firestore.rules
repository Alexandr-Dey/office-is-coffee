rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return request.auth != null && request.auth.token.role == role;
    }

    function isBaristaOrCeo() {
      return hasRole('barista') || hasRole('ceo');
    }

    // users — anyone auth can read (needed for CEO client list, barista deposits)
    // write: own doc only, protected fields checked
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // orders — anyone auth can read (barista needs to see all)
    // create: own orders only, status must be "new"
    // update: anyone auth (barista changes status, client rates)
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // deposits — anyone auth can read (barista top-up flow)
    // write: barista/ceo only (через Custom Claims; CF использует admin SDK
    // и обходит rules)
    match /deposits/{uid} {
      allow read: if isAuthenticated();
      allow write: if isBaristaOrCeo();
    }

    // barista_bonuses — barista/ceo write (barista requests payout, CEO approves)
    match /barista_bonuses/{uid} {
      allow read: if isAuthenticated();
      allow write: if isBaristaOrCeo();
    }

    // barista_hearts — public read, auth write (clients tap baristas)
    match /barista_hearts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // cafe_status — public read, auth write (barista toggles)
    match /cafe_status/{cafeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // push_tokens — own token only for write, auth read for CEO push
    match /push_tokens/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // menu_items — public read, auth write (barista/CEO edit)
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // menu_overrides — публичное чтение (клиенты видят актуальные цены);
    // write: barista/ceo через Custom Claims (выставляются скриптом
    // scripts/set-roles.ts).
    match /menu_overrides/{itemId} {
      allow read: if true;
      allow write: if isBaristaOrCeo();
    }

    // push_log — auth read/write
    match /push_log/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // cookie_log
    match /cookie_log/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // cache
    match /cache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // scene_ambient
    match /scene_ambient/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // promo_codes — read любому auth (применение кода клиентом),
    // write только CEO
    match /promo_codes/{code} {
      allow read: if isAuthenticated();
      allow write: if hasRole('ceo');
    }

    // feedback — клиент создаёт жалобы/предложения; читать может любой auth
    // (страница /ceo/feedback защищена useRequireCEO на клиенте)
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
