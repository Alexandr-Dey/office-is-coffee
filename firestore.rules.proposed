// PROPOSED Security Rules — НЕ задеплоено.
// Текущие firestore.rules слишком открыты:
//   - deposits/barista_bonuses: любой auth может писать → можно списывать чужие деньги
//   - orders update: любой auth может менять чужой статус
//   - menu_items/push_log: любой auth может писать
// Перед деплоем: протестировать через эмулятор + @firebase/rules-unit-testing.
// Команда деплоя: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBarista() {
      return isAuthenticated() && (userRole() == 'barista' || userRole() == 'ceo');
    }

    function isCEO() {
      return isAuthenticated() && userRole() == 'ceo';
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid)
                        && !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['role', 'loyaltyCount', 'streak', 'lastOrderDate']))
                    || isBarista();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid || isBarista());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.total >= 0;
      allow update: if isBarista()
                    || (isOwner(resource.data.userId)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['rating']));
      allow delete: if false;
    }

    match /deposits/{uid} {
      allow read: if isOwner(uid) || isBarista();
      allow write: if false; // Только Cloud Functions через Admin SDK
    }

    match /barista_bonuses/{uid} {
      allow read: if isOwner(uid) || isCEO();
      allow write: if false;
    }

    match /barista_hearts/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /cafe_status/{cafeId} {
      allow read: if true;
      allow write: if isBarista();
    }

    match /push_tokens/{uid} {
      allow read: if isBarista();
      allow write: if isOwner(uid);
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isCEO();
    }

    match /push_log/{logId} {
      allow read: if isCEO();
      allow write: if false;
    }

    match /cookie_log/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /cache/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /scene_ambient/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /promo_codes/{code} {
      allow read: if isAuthenticated();
      allow write: if isCEO();
    }
  }
}
